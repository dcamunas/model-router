{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/router-hook.sh",
            "timeout": 10,
            "statusMessage": "router: picking a model"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/router-hook.sh --bootstrap",
            "timeout": 180,
            "statusMessage": "router: preparing the hook"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/router-hook.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
