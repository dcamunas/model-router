{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/tribunal-hook.sh",
            "timeout": 150,
            "statusMessage": "tribunal: noting where the turn starts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/tribunal-hook.sh",
            "timeout": 2400,
            "statusMessage": "tribunal: two judges are reviewing the change"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/tribunal-hook.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
